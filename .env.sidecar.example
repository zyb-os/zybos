# .env.sidecar.example — sidecar deployment configuration
#
# Copy to .env.sidecar and fill in only what you need.
# Everything marked DASHBOARD is configured via http://localhost:8000
# after first boot — no need to set it here.
#
# ── Ports (optional overrides) ────────────────────────────────────────────────
# ORCHESTRATOR_PORT=8000
# CHROME_MCP_PORT=8765
# WHATSAPP_WEBHOOK_PORT=8080
# TELEGRAM_WEBHOOK_PORT=8081
# AVATAR_PORT=8010

# ── Log level ─────────────────────────────────────────────────────────────────
# LOG_LEVEL=INFO

# ── Orchestrator encryption key ───────────────────────────────────────────────
# Persist settings across container rebuilds.  Generate once with:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# ORCHESTRATOR_SETTINGS_ENCRYPTION_KEY=

# ── Telegram agent (must be set at startup — cannot be set via dashboard) ─────
# TELEGRAM_BOT_TOKEN=
# TELEGRAM_WEBHOOK_URL=
# TELEGRAM_WEBHOOK_SECRET=
# TELEGRAM_ROUTING_TARGET=
