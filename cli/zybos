#!/usr/bin/env bash
# zybos — CLI for managing ZybOS agents.
#
# Subcommands:
#   start   [agent]            Start all agents (or a single named agent)
#   stop    [agent]            Stop all agents (or a single named agent)
#   restart [agent]            Restart all or one agent
#   status                     Show running / stopped agents
#   logs    [agent] [-f]       Tail combined logs (or a specific agent's log)
#   update                     Pull latest source and reinstall dependencies
#   service install|uninstall  Register/remove systemd or launchd service
#   uninstall                  Remove the entire installation
#
set -euo pipefail

# ── Installation root (replaced by install.sh) ────────────────────────────────
INSTALL_DIR="${HOME}/.zybos"

# ── Source config ─────────────────────────────────────────────────────────────
CONFIG_FILE="${INSTALL_DIR}/config.env"
if [[ -f "${CONFIG_FILE}" ]]; then
  # shellcheck source=/dev/null
  source "${CONFIG_FILE}"
fi

SRC_DIR="${SRC_DIR:-${INSTALL_DIR}/src}"
VENV_DIR="${VENV_DIR:-${INSTALL_DIR}/venvs}"
LOG_DIR="${LOG_DIR:-${INSTALL_DIR}/logs}"
RUN_DIR="${RUN_DIR:-${INSTALL_DIR}/run}"
ORCHESTRATOR_URL="${ORCHESTRATOR_URL:-http://localhost:8000}"
LOG_LEVEL="${LOG_LEVEL:-INFO}"
MANIFEST="${INSTALL_DIR}/agents.txt"

# ── Colours ───────────────────────────────────────────────────────────────────
RED='\033[0;31m'; GREEN='\033[0;32m'; YELLOW='\033[1;33m'
CYAN='\033[0;36m'; BOLD='\033[1m'; RESET='\033[0m'
info()  { printf "${CYAN}▶${RESET}  %s\n" "$*"; }
ok()    { printf "${GREEN}✓${RESET}  %s\n" "$*"; }
warn()  { printf "${YELLOW}⚠${RESET}  %s\n" "$*"; }
die()   { printf "${RED}✗${RESET}  %s\n" "$*" >&2; exit 1; }

# ── Helpers ───────────────────────────────────────────────────────────────────
_agents() {
  # Returns the installed agent list (manifest), or all src dirs
  if [[ -f "${MANIFEST}" ]]; then
    cat "${MANIFEST}"
  else
    ls "${SRC_DIR}/" 2>/dev/null || true
  fi
}

_pid_file() { echo "${RUN_DIR}/${1}.pid"; }
_log_file()  { echo "${LOG_DIR}/${1}.log"; }

_is_running() {
  local agent="$1"
  local pid_file
  pid_file="$(_pid_file "${agent}")"
  if [[ -f "${pid_file}" ]]; then
    local pid
    pid="$(cat "${pid_file}")"
    if kill -0 "${pid}" 2>/dev/null; then
      return 0
    fi
    rm -f "${pid_file}"
  fi
  return 1
}

_python_for() {
  local agent="$1"
  local venv_python="${VENV_DIR}/${agent}/bin/python"
  if [[ -x "${venv_python}" ]]; then
    echo "${venv_python}"
  else
    echo "python3"
  fi
}

_start_one() {
  local agent="$1"
  local src="${SRC_DIR}/${agent}"
  local pid_file
  pid_file="$(_pid_file "${agent}")"
  local log_file
  log_file="$(_log_file "${agent}")"
  local python
  python="$(_python_for "${agent}")"

  if _is_running "${agent}"; then
    warn "${agent} is already running (pid $(cat "${pid_file}"))"
    return
  fi

  if [[ ! -f "${src}/main.py" ]]; then
    warn "${agent}: no main.py found at ${src}, skipping"
    return
  fi

  mkdir -p "${RUN_DIR}" "${LOG_DIR}"

  local extra_args=()
  if [[ "${agent}" != "agent-orchestrator" ]]; then
    extra_args=(--orchestrator-url "${ORCHESTRATOR_URL}")
  fi

  # Env overrides per agent
  local env_prefix="LOG_LEVEL=${LOG_LEVEL}"
  if [[ "${agent}" == "task-executor-agent" ]]; then
    env_prefix="LOG_LEVEL=${LOG_LEVEL} LOG_MESSAGE_BODIES=true"
  fi

  # Start detached, redirect stdout+stderr to log file
  (
    cd "${src}"
    export LOG_LEVEL="${LOG_LEVEL}"
    [[ "${agent}" == "task-executor-agent" ]] && export LOG_MESSAGE_BODIES=true
    exec "${python}" main.py "${extra_args[@]}" >> "${log_file}" 2>&1
  ) &
  local pid=$!
  echo "${pid}" > "${pid_file}"
  ok "Started ${agent} (pid ${pid})"
}

_stop_one() {
  local agent="$1"
  local pid_file
  pid_file="$(_pid_file "${agent}")"
  if ! _is_running "${agent}"; then
    warn "${agent} is not running"
    return
  fi
  local pid
  pid="$(cat "${pid_file}")"
  kill "${pid}" 2>/dev/null && ok "Stopped ${agent} (pid ${pid})" || warn "Failed to signal ${agent}"
  # Wait up to 5 s
  for _ in 1 2 3 4 5; do
    kill -0 "${pid}" 2>/dev/null || break
    sleep 1
  done
  kill -9 "${pid}" 2>/dev/null || true
  rm -f "${pid_file}"
}

# ── Subcommands ───────────────────────────────────────────────────────────────

cmd_start() {
  local target="${1:-}"
  if [[ -n "${target}" ]]; then
    _start_one "${target}"
    return
  fi

  info "Starting agents…"
  # Orchestrator first
  _start_one "agent-orchestrator"
  sleep 2

  while IFS= read -r agent; do
    [[ "${agent}" == "agent-orchestrator" ]] && continue
    _start_one "${agent}"
  done < <(_agents)

  echo ""
  printf "${BOLD}All agents started.${RESET} Dashboard → ${ORCHESTRATOR_URL}\n"
}

cmd_stop() {
  local target="${1:-}"
  if [[ -n "${target}" ]]; then
    _stop_one "${target}"
    return
  fi

  info "Stopping agents…"
  # Stop workers first, orchestrator last
  while IFS= read -r agent; do
    [[ "${agent}" == "agent-orchestrator" ]] && continue
    _is_running "${agent}" && _stop_one "${agent}" || true
  done < <(_agents)
  _is_running "agent-orchestrator" && _stop_one "agent-orchestrator" || true
  ok "All agents stopped"
}

cmd_restart() {
  local target="${1:-}"
  if [[ -n "${target}" ]]; then
    _stop_one "${target}"
    sleep 1
    _start_one "${target}"
    return
  fi
  cmd_stop
  sleep 1
  cmd_start
}

cmd_status() {
  printf "\n${BOLD}%-40s %-10s %s${RESET}\n" "AGENT" "STATUS" "PID"
  printf "%s\n" "$(printf '─%.0s' {1..65})"
  while IFS= read -r agent; do
    local pid_file
    pid_file="$(_pid_file "${agent}")"
    if _is_running "${agent}"; then
      local pid
      pid="$(cat "${pid_file}")"
      printf "%-40s ${GREEN}%-10s${RESET} %s\n" "${agent}" "running" "${pid}"
    else
      printf "%-40s ${RED}%-10s${RESET}\n" "${agent}" "stopped"
    fi
  done < <(_agents)
  echo ""
}

cmd_logs() {
  local target="${1:-}"
  local follow=0
  shift || true
  while [[ $# -gt 0 ]]; do
    case "$1" in
      -f|--follow) follow=1; shift ;;
      *) target="$1"; shift ;;
    esac
  done

  if [[ -n "${target}" ]]; then
    local log
    log="$(_log_file "${target}")"
    [[ -f "${log}" ]] || die "No log file: ${log}"
    if [[ "${follow}" == "1" ]]; then
      tail -f "${log}"
    else
      tail -n 100 "${log}"
    fi
    return
  fi

  # Combined log for all agents
  local log_files=()
  while IFS= read -r agent; do
    local lf
    lf="$(_log_file "${agent}")"
    [[ -f "${lf}" ]] && log_files+=("${lf}")
  done < <(_agents)

  if [[ ${#log_files[@]} -eq 0 ]]; then
    warn "No log files found yet. Start agents first."
    return
  fi

  if [[ "${follow}" == "1" ]]; then
    tail -f "${log_files[@]}"
  else
    tail -n 50 "${log_files[@]}"
  fi
}

cmd_update() {
  info "Updating ZybOS…"

  local repo="${GITHUB_REPO:-ZybOS/agent-orchestrator}"
  local branch="${GITHUB_BRANCH:-main}"

  # ── Download latest source ────────────────────────────────────────────────
  local tmp_repo="${INSTALL_DIR}/.repo-update"
  rm -rf "${tmp_repo}"

  if command -v git &>/dev/null; then
    info "Fetching latest from GitHub (git clone)…"
    git clone --depth=1 --branch "${branch}" \
      "https://github.com/${repo}.git" "${tmp_repo}" 2>&1 \
      | grep -v "^$" || die "git clone failed. Check network and repo URL."
  elif command -v curl &>/dev/null || command -v wget &>/dev/null; then
    local tarball_url="https://github.com/${repo}/archive/refs/heads/${branch}.tar.gz"
    local tmp_tar="${INSTALL_DIR}/.update.tar.gz"
    info "Downloading source tarball from GitHub…"
    if command -v curl &>/dev/null; then
      curl -fsSL --progress-bar "${tarball_url}" -o "${tmp_tar}"
    else
      wget -q --show-progress "${tarball_url}" -O "${tmp_tar}"
    fi
    mkdir -p "${tmp_repo}"
    tar -xzf "${tmp_tar}" -C "${tmp_repo}" --strip-components=1
    rm -f "${tmp_tar}"
  else
    die "Cannot update: install git, curl, or wget."
  fi

  [[ -f "${tmp_repo}/agent-orchestrator/main.py" ]] || \
    die "Downloaded source is incomplete. Check --repo / --branch."

  # ── Sync agent source files ───────────────────────────────────────────────
  info "Syncing agent source files…"
  while IFS= read -r agent; do
    local src="${tmp_repo}/${agent}"
    [[ -d "${src}" ]] || continue
    printf "  %-40s" "${agent}…"
    if command -v rsync &>/dev/null; then
      rsync -a --delete \
        --exclude='.venv/' --exclude='venv/' --exclude='__pycache__/' \
        --exclude='.git/' --exclude='*.pyc' --exclude='data/' \
        "${src}/" "${SRC_DIR}/${agent}/"
    else
      rm -rf "${SRC_DIR:?}/${agent}"
      cp -rp "${src}" "${SRC_DIR}/${agent}"
      for excl in .venv venv __pycache__ .git data; do
        rm -rf "${SRC_DIR}/${agent}/${excl}"
      done
    fi
    printf " ok\n"
  done < <(_agents)

  # ── Also update the CLI script itself ─────────────────────────────────────
  if [[ -f "${tmp_repo}/cli/zybos" ]]; then
    cp "${tmp_repo}/cli/zybos" "${INSTALL_DIR}/bin/zybos"
    chmod +x "${INSTALL_DIR}/bin/zybos"
    sed -i.bak "s|^INSTALL_DIR=.*|INSTALL_DIR=\"${INSTALL_DIR}\"|" \
      "${INSTALL_DIR}/bin/zybos" 2>/dev/null || true
    rm -f "${INSTALL_DIR}/bin/zybos.bak"
    ok "CLI script updated"
  fi

  rm -rf "${tmp_repo}"

  # ── Reinstall dependencies for changed agents ─────────────────────────────
  info "Updating dependencies…"
  while IFS= read -r agent; do
    local req="${SRC_DIR}/${agent}/requirements.txt"
    local venv="${VENV_DIR}/${agent}"
    [[ -f "${req}" && -d "${venv}" ]] || continue
    printf "  %-40s" "${agent}…"
    "${venv}/bin/pip" install --quiet --upgrade -r "${req}" 2>/dev/null && echo " ok" || echo " warn"
  done < <(_agents)

  ok "Update complete. Restart with: zybos restart"
}

cmd_service() {
  local action="${1:-install}"
  local os
  os="$(uname -s)"

  case "${os}" in
    Darwin) _service_macos "${action}" ;;
    Linux)  _service_linux "${action}" ;;
    *) die "Service management not supported on ${os}" ;;
  esac
}

_service_macos() {
  local action="$1"
  local plist="${HOME}/Library/LaunchAgents/com.zybos.plist"
  local cli_script
  cli_script="$(readlink -f "${INSTALL_DIR}/bin/zybos")"

  case "${action}" in
    install)
      mkdir -p "${HOME}/Library/LaunchAgents"
      cat > "${plist}" <<PLIST
<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN"
  "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>com.zybos</string>
  <key>ProgramArguments</key>
  <array>
    <string>${cli_script}</string>
    <string>start</string>
  </array>
  <key>RunAtLoad</key>
  <true/>
  <key>KeepAlive</key>
  <false/>
  <key>StandardOutPath</key>
  <string>${LOG_DIR}/launchd.log</string>
  <key>StandardErrorPath</key>
  <string>${LOG_DIR}/launchd.err</string>
</dict>
</plist>
PLIST
      launchctl load -w "${plist}"
      ok "launchd service installed and enabled (starts at login)"
      ;;
    uninstall)
      launchctl unload -w "${plist}" 2>/dev/null || true
      rm -f "${plist}"
      ok "launchd service removed"
      ;;
    *) die "Unknown action: ${action}. Use install or uninstall." ;;
  esac
}

_service_linux() {
  local action="$1"
  local service_file="/etc/systemd/system/zybos.service"
  local cli_script="${INSTALL_DIR}/bin/zybos"

  case "${action}" in
    install)
      sudo tee "${service_file}" > /dev/null <<SERVICE
[Unit]
Description=ZybOS
After=network.target

[Service]
Type=forking
User=${USER}
ExecStart=${cli_script} start
ExecStop=${cli_script} stop
Restart=on-failure
RestartSec=5
EnvironmentFile=-${CONFIG_FILE}
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
SERVICE
      sudo systemctl daemon-reload
      sudo systemctl enable zybos
      ok "systemd service installed and enabled"
      info "  Start now: sudo systemctl start zybos"
      ;;
    uninstall)
      sudo systemctl disable zybos 2>/dev/null || true
      sudo systemctl stop zybos 2>/dev/null || true
      sudo rm -f "${service_file}"
      sudo systemctl daemon-reload
      ok "systemd service removed"
      ;;
    *) die "Unknown action: ${action}. Use install or uninstall." ;;
  esac
}

cmd_uninstall() {
  local install_script
  install_script="$(dirname "$(readlink -f "$0")")/../../cli/uninstall.sh"
  if [[ -f "${install_script}" ]]; then
    bash "${install_script}" "${INSTALL_DIR}"
  else
    # Inline uninstall
    warn "Stopping all running agents…"
    cmd_stop 2>/dev/null || true

    warn "Removing service (if installed)…"
    cmd_service uninstall 2>/dev/null || true

    warn "Removing installation directory: ${INSTALL_DIR}"
    read -r -p "Are you sure? This deletes all data, configs, and venvs. [y/N] " confirm
    [[ "${confirm}" == "y" || "${confirm}" == "Y" ]] || { info "Uninstall cancelled."; exit 0; }

    rm -rf "${INSTALL_DIR}"
    rm -f "${HOME}/.local/bin/zybos"
    ok "ZybOS has been removed."
  fi
}

cmd_help() {
  cat <<HELP

${BOLD}zybos${RESET} — ZybOS CLI

${BOLD}USAGE${RESET}
  zybos <command> [options]

${BOLD}COMMANDS${RESET}
  start   [agent]            Start all agents (or a single named agent)
  stop    [agent]            Stop all agents (or a single named agent)
  restart [agent]            Restart all agents (or a single named agent)
  status                     Show running/stopped state of all agents
  logs    [agent] [-f]       Show recent logs; -f to stream live
  update                     Pull latest code and reinstall dependencies
  service install|uninstall  Register or remove OS service (systemd/launchd)
  uninstall                  Remove the entire installation
  help                       Show this message

${BOLD}EXAMPLES${RESET}
  zybos start
  zybos start task-planner-agent
  zybos logs browser-agent -f
  zybos status
  zybos service install

${BOLD}FILES${RESET}
  Config   : ${INSTALL_DIR}/config.env
  Agents   : ${INSTALL_DIR}/agents.txt
  Logs     : ${LOG_DIR}/
  PID files: ${RUN_DIR}/

HELP
}

# ── Entrypoint ────────────────────────────────────────────────────────────────
CMD="${1:-help}"
shift || true

case "${CMD}" in
  start)    cmd_start "$@" ;;
  stop)     cmd_stop "$@" ;;
  restart)  cmd_restart "$@" ;;
  status)   cmd_status ;;
  logs)     cmd_logs "$@" ;;
  update)   cmd_update ;;
  service)  cmd_service "$@" ;;
  uninstall) cmd_uninstall ;;
  help|--help|-h) cmd_help ;;
  *) die "Unknown command: ${CMD}. Run 'zybos help'." ;;
esac
